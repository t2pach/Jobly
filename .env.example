# Окружение: dev | prod. В prod приложение не стартует с дефолтными секретами.
APP_ENV=dev
# PostgreSQL для production, SQLite допустим только для локальной разработки
DATABASE_URL=postgresql+psycopg://jobly:jobly@localhost:5432/jobly
# Длинная случайная строка: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_TTL_MINUTES=1440
# Ключ Fernet для шифрования токенов внешних сервисов:
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SECRETS_KEY=
# Адреса фронтенда через запятую
CORS_ORIGINS=http://localhost:3000
# Email администраторов через запятую (получают роль admin при регистрации)
ADMIN_EMAILS=
PROVIDER_TIMEOUT_S=8

# Работа России (открытые данные, ключ не нужен)
TRUDVSEM_ENABLED=true
TRUDVSEM_BASE_URL=https://opendata.trudvsem.ru/api/v1
# SuperJob: секретный ключ приложения. Адаптер пока не реализован, см. docs/LIMITATIONS.md
SUPERJOB_ENABLED=false
SUPERJOB_APP_SECRET=
# hh.ru: регистрация приложения на dev.hh.ru. Адаптер пока не реализован, см. docs/LIMITATIONS.md
HH_ENABLED=false
HH_CLIENT_ID=
HH_CLIENT_SECRET=
